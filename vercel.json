      "maxDuration": 60
    },
    "src/app/api/agents/nightwatch/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/appointment-reminders/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/invoice-chase/route.ts": {
